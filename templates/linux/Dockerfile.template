FROM ${base_image}:${jdk_version}-latest

ENV CATALINA_HOME /usr/local/tomcat
ENV PATH $CATALINA_HOME/bin:$PATH

RUN set -ex && \
    ${install_line}mkdir -p "$CATALINA_HOME" && \
    ${download_tool} ${download_flags} tomcat${archive_ext} "${tomcat_url}${archive_ext}" && \
    ${extract_cmd} && \
    ${file_cleanup_cmd}${cleanup_line}

EXPOSE 8080
CMD ["${run_cmd}", "run"]
